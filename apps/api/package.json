    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/csrf-protection": "8.0.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "fastify": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.4.1",
    "@nestjs/testing": "11.1.28",
    "@types/node": "24.13.3",
    "fast-check": "4.9.0"
  }
