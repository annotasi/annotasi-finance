# Non-secret local foundation settings.
APP_ENV=development
PORT=3001

# Identity/session settings for SLICE-IAM-001. Replace secret placeholders
# with local sandbox values; never commit real values.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
DATABASE_APPLICATION_URL=postgresql://annotasi_application:local_application_only_2026@127.0.0.1:5432/annotasi_finance_local
SESSION_COOKIE_NAME=af_session
SESSION_TTL_SECONDS=2592000
CSRF_SECRET=replace_with_a_random_value_at_least_32_characters_long
# Local-development-only exception: allows a non-Secure cookie over plain
# HTTP. Never set to false when APP_ENV=production (validated and rejected).
SECURE_COOKIES=false
