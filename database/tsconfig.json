{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "drizzle.config.ts",
    "schema/**/*.ts",
    "scripts/**/*.mjs",
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
