{
  "name": "@annotasi/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private migration and integration tooling for the database foundation probe, plus a runtime-safe session-store entry point for apps/api.",
  "exports": {
    "./runtime": {
      "types": "./dist/src/runtime/index.d.ts",
      "default": "./dist/src/runtime/index.js"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate --config drizzle.config.ts --name foundation_probe",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "db:check": "vitest run test/migration.integration.test.ts --testTimeout=120000 --hookTimeout=120000",
    "db:test": "vitest run test/rls-and-bigint.integration.test.ts test/session-store.integration.test.ts test/onboarding.integration.test.ts test/private-beta-invitation-cli.test.ts test/account.integration.test.ts --testTimeout=120000 --hookTimeout=120000",
    "db:test:sessions": "vitest run test/session-store.integration.test.ts --testTimeout=120000 --hookTimeout=120000",
    "db:test:onboarding": "vitest run test/onboarding.integration.test.ts test/private-beta-invitation-cli.test.ts --testTimeout=120000 --hookTimeout=120000",
    "db:test:accounts": "vitest run test/account.integration.test.ts --testTimeout=120000 --hookTimeout=120000",
    "invite:issue": "node scripts/private-beta-invitation.mjs issue",
    "invite:revoke": "node scripts/private-beta-invitation.mjs revoke"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/pg": "8.20.3",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.0.4"
  }
}
